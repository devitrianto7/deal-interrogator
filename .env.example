# Meta Model API key (https://dev.meta.ai/platform -> API keys)
MODEL_API_KEY=
# dev = muse-spark-1.3-contributor, demo = muse-spark-1.3 (judge is always muse-wonder-1.0)
MODEL_MODE=dev
# Hard stop for model spend in USD (Meta has no hard cap)
BUDGET_USD=140
RATE_LIMIT_PER_HOUR=10
# Baseten key (Muse Spark Open). When set, the Prosecutor and Defender run on Baseten;
# any Baseten failure falls back to Meta for that call. SPARK_PROVIDER=meta turns it off.
BASETEN_API_KEY=
# SPARK_PROVIDER=meta
# Roles sent to Baseten (judge always stays on Meta)
# SPARK_ROLES=prosecutor,defender
# Runaway guard for Baseten spend in USD (prepaid credit; at the cap calls go to Meta)
BASETEN_BUDGET_USD=50
# Optional: TinyFish Fetch renders JavaScript/bot-shielded vendor pages (fallback before r.jina.ai).
# Free up to 1,000 URLs/day. Unset = step skipped.
# TINYFISH_API_KEY=
